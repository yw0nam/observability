{
  "uid": "obs-cardinality",
  "id": null,
  "title": "Observability: Cardinality & Stack Health",
  "description": "Watch series/stream counts to catch cardinality blow-ups before they take Prometheus down. Includes OTel collector throughput and deltatocumulative processor state.",
  "tags": [
    "observability",
    "cardinality",
    "ops"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Prometheus Cardinality",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active Series (head)",
      "description": "Total time series currently in Prometheus head block. Rule of thumb: <1M comfortable, >5M consider Mimir/Thanos or aggressive label strip.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "prometheus_tsdb_head_series",
          "legendFormat": "head series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 500000
              },
              {
                "color": "orange",
                "value": 1000000
              },
              {
                "color": "red",
                "value": 5000000
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Ingestion Rate (samples/s)",
      "description": "Samples being appended per second across all targets.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
