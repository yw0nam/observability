# Copy this file to .env and fill in a real token, then `docker compose up -d`.
#   cp .env.example .env
#
# Generate a strong token:
#   openssl rand -hex 32
#
# Every OTLP sender (Claude Code / OpenCode / Hermes) must present this exact
# value as:  Authorization: Bearer <token>
# See docs/otel-setting.md for the per-agent env var.
OTEL_AUTH_TOKEN=
